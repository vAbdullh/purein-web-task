# Keep database files, logs, and repository metadata private.
<FilesMatch "(?i)(^\.|\.(sqlite|sqlite3|db)(-.*)?$|\.log$|\.md$|^Dockerfile$)">
    Require all denied
</FilesMatch>

# Block private directories as well as individual files.
RedirectMatch 404 "(?i)/(\.git|logs)(/|$)"

# Show friendly pages for server-level errors too.
ErrorDocument 400 /error.php
ErrorDocument 403 /error.php
ErrorDocument 404 /error.php
ErrorDocument 500 /error.php
